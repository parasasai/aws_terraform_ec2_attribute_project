pipeline {
    agent any

    environment {
        // Safe mapping of your unified AWS plugin credentials
        AWS_CREDENTIALS       = credentials('aws-credentials-id')
        AWS_ACCESS_KEY_ID     = env.AWS_ACCESS_KEY_ID
        AWS_SECRET_ACCESS_KEY = env.AWS_SECRET_ACCESS_KEY
        
        // Suppresses interactive terminal prompts during the destruction loop
        TF_IN_AUTOMATION      = 'true'
    }

    stages {
        stage('Fetch Infrastructure Code') {
            steps {
                // Pulls down your code to reference your remote S3 state configuration
                checkout scm
            }
        }

        stage('Terraform Initialization') {
            steps {
                // Connects to your existing S3 backend state tracking file
                sh 'terraform init'
            }
        }

        stage('Destruction Preview Plan') {
            steps {
                // Generates a preview plan showing exactly what resources will be deleted
                sh 'terraform plan -destroy'
            }
        }

        stage('Safety Confirmation Gate') {
            steps {
                // Pauses and forces a manual confirmation step before wiping the environment
                input message: "⚠️ WARNING: Are you completely sure you want to DESTROY all deployed AWS resources?", 
                      ok: "Yes, Destroy Everything"
            }
        }

        stage('Terraform Destroy Execution') {
            steps {
                echo "Wiping infrastructure from AWS Cloud..."
                // Executes the destruction sequence cleanly across your AWS account
                sh 'terraform destroy -auto-approve'
            }
        }
    }

    post {
        always {
            // Wipes the transient git workspace directory files from your local host machine
            cleanWs()
        }
    }
}
