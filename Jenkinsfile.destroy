pipeline {
    agent any

    environment {
        // Suppresses interactive prompts since it is running via background automation
        TF_IN_AUTOMATION = 'true'
    }

    stages {
        stage('Fetch Infrastructure Code') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Teardown Work') {
            steps {
                // Securely extracts your saved AWS credentials plugin wrapper directly into memory
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding', 
                    credentialsId: 'aws-credentials-id', 
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID', 
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    
                    echo "=== Starting Destruction Pipeline ==="
                    
                    echo "Connecting to your remote S3 backend state tracking file..."
                    sh 'terraform init'
                    
                    echo "Generating destruction preview plan..."
                    sh 'terraform plan -destroy'
                    
                    // Safety gate to prevent unintended deletions
                    input message: "⚠️ WARNING: Are you completely sure you want to DESTROY all deployed AWS resources?", 
                          ok: "Yes, Destroy Everything"
                    
                    echo "Wiping infrastructure from AWS Cloud..."
                    sh 'terraform destroy -auto-approve'
                }
            }
        }
    }

    post {
        always {
            // Cleans up local workspace temporary files safely
            cleanWs()
        }
    }
}
